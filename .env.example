# Stripe - get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret - from https://dashboard.stripe.com/webhooks
# (endpoint URL: https://<your-domain>/api/stripe/webhook, event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Canonical site URL (used for Stripe success/cancel redirects).
# Optional on Vercel - falls back to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
